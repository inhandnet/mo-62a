#!/bin/bash
# csi-camera-demo — 在"当前 CSI 摄像头"上跑 model_zoo 模型 (VPAC VISS/MSC + C7x TIDL + KMS)
#
# 与摄像头解耦:摄像头由 csi-camera-init 选择/初始化(产出 video 节点),本命令
# 只负责"列模型 → 选一个 → 跑推理",任何 CSI 摄像头 × 任何已部署模型 自由组合。
#
# 用法:
#   csi-camera-demo                列出模型并进交互菜单(输编号运行)
#   csi-camera-demo list           只列出已部署模型(按类型分组, 标运行时)
#   csi-camera-demo run <编号|名>  跑指定模型(需 root, 会自动 sudo)
#   csi-camera-demo <编号|名>      run 的简写
#
# 模型来自 /opt/model_zoo(部署什么列什么)。画面走 KMS 在 HDMI 显示, Ctrl+C 退出。
set -uo pipefail

MODEL_ZOO="${CSI_MODEL_ZOO:-/opt/model_zoo}"
CONF_DIR="${CSI_CONF_DIR:-/etc/csi-camera/cameras.d}"
SELECTED="${CSI_SELECTED:-/etc/csi-camera/selected}"
APP="${CSI_APP:-/opt/edgeai-gst-apps/apps_python/app_edgeai.py}"
RPROC=/sys/class/remoteproc/remoteproc0/state
SELF=/usr/local/bin/csi-camera-demo

c_grn=$'\e[32m'; c_yel=$'\e[33m'; c_dim=$'\e[2m'; c_rst=$'\e[0m'
err() { echo "csi-camera-demo: $*" >&2; }

# ---- 模型清单(扫 MODEL_ZOO, 按 类型→名称 排序) --------------------------
declare -a MODELS
type_label() { case "$1" in OD) echo "检测 Detection";; SS) echo "分割 Segmentation";; CL) echo "分类 Classification";; KD|6DOF) echo "姿态 Pose";; *) echo "其他 $1";; esac; }
rt_label()   { case "$1" in ONR) echo "ONNX";; TFL) echo "TFLite";; TVM) echo "TVM";; *) echo "$1";; esac; }
rt_note()    { case "$1" in ONR) echo "";; TFL|TVM) echo " ${c_yel}(未验证)${c_rst}";; esac; }

build_model_list() {
  MODELS=(); local d name type rank entries=()
  for d in "$MODEL_ZOO"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    [ -d "$d/artifacts" ] || continue          # 无 artifacts 不是可跑模型
    type="$(echo "$name" | cut -d- -f2)"
    case "$type" in OD) rank=1;; SS) rank=2;; CL) rank=3;; KD|6DOF) rank=4;; *) rank=5;; esac
    entries+=("$rank|$name")
  done
  local line n
  while IFS='|' read -r _ n; do [ -n "$n" ] && MODELS+=("$n"); done \
    < <(printf '%s\n' "${entries[@]}" | sort -t'|' -k1,1n -k2)
}

cmd_list() {
  build_model_list
  [ "${#MODELS[@]}" -gt 0 ] || { err "未发现模型 ($MODEL_ZOO)"; return 1; }
  echo "已部署模型 (在 $MODEL_ZOO):"
  local i=0 prev="" name type rt
  for name in "${MODELS[@]}"; do
    i=$((i+1)); type="$(echo "$name" | cut -d- -f2)"; rt="$(echo "$name" | cut -d- -f1)"
    [ "$type" != "$prev" ] && { echo; echo " ${c_dim}── $(type_label "$type") ──${c_rst}"; prev="$type"; }
    printf "  %2d) %-52s [%s]%b\n" "$i" "$name" "$(rt_label "$rt")" "$(rt_note "$rt")"
  done
  echo; echo "${c_dim}运行: csi-camera-demo run <编号|名>  (TFL/TVM 标注未验证, 可能跑不起来)${c_rst}"
}

resolve_model() {                 # 编号 或 名(精确/唯一子串) -> echo 目录名
  build_model_list
  local sel="$1" m hit=""
  if [[ "$sel" =~ ^[0-9]+$ ]]; then
    local idx=$((sel-1))
    [ "$idx" -ge 0 ] && [ "$idx" -lt "${#MODELS[@]}" ] && { echo "${MODELS[$idx]}"; return 0; }
    return 1
  fi
  for m in "${MODELS[@]}"; do [ "$m" = "$sel" ] && { echo "$m"; return 0; }; done
  for m in "${MODELS[@]}"; do case "$m" in *"$sel"*) hit="$m";; esac; done
  [ -n "$hit" ] && { echo "$hit"; return 0; }
  return 1
}

# ---- 当前摄像头(来自 csi-camera-init 的 selected) -------------------------
load_current_camera() {
  [ -f "$SELECTED" ] || { err "未选择 CSI 摄像头。先运行: ${c_grn}csi-camera-init <id>${c_rst} (如 imx219) 并重启"; return 1; }
  local id; id="$(cat "$SELECTED" 2>/dev/null)"
  local f="$CONF_DIR/$id.conf"
  [ -f "$f" ] || { err "摄像头描述符丢失: $f"; return 1; }
  local VIDEO="" SUBDEV="" WIDTH="" HEIGHT="" FORMAT="" FRAMERATE="" INIT=""
  # shellcheck disable=SC1090
  . "$f"
  CAM_ID="$id"; CAM_VIDEO="$VIDEO"; CAM_SUBDEV="$SUBDEV"
  CAM_W="$WIDTH"; CAM_H="$HEIGHT"; CAM_FMT="$FORMAT"; CAM_FPS="${FRAMERATE:-30}"; CAM_INIT="$INIT"
  [ -n "$CAM_VIDEO" ] || { err "$id.conf 缺 VIDEO=(demo 输入参数)"; return 1; }
}

build_yaml() {                    # 目录名 -> 写 /tmp 临时 yaml, echo 路径
  local model="$1" out=/tmp/csi-camera-demo.yaml
  cat > "$out" <<EOF
title: "CSI demo — $model"
log_level: 2
inputs:
    input0:
        source: $CAM_VIDEO
        subdev-id: $CAM_SUBDEV
        width: $CAM_W
        height: $CAM_H
        format: $CAM_FMT
        framerate: $CAM_FPS
models:
    model0:
        model_path: $MODEL_ZOO/$model
        viz_threshold: 0.4
outputs:
    output0:
        sink: kmssink
        width: 1920
        height: 1080
        overlay-perf-type: graph
flows:
    flow0: [input0,model0,output0,[320,150,1280,720]]
EOF
  echo "$out"
}

# ---- 跑 demo(稳健: 清残留/停桌面/c7x reset/预热/退出恢复) ------------------
kill_app() { pkill -KILL -f "^python3 .*app_edgeai\.py" 2>/dev/null || true; }
c7x_reset() { echo stop > "$RPROC" 2>/dev/null || true; sleep 1; echo start > "$RPROC" 2>/dev/null || true; sleep 3; }
cleanup()  { kill_app; systemctl start lightdm 2>/dev/null || true; }

cmd_run() {
  local sel="$1"
  [ "$(id -u)" -eq 0 ] || exec sudo -E "$SELF" run "$sel"   # 以 run+选择 重入, 不丢上下文
  local model; model="$(resolve_model "$sel")" || { err "无此模型: '$sel' (见 csi-camera-demo list)"; exit 1; }
  load_current_camera || exit 1
  [ -e "$CAM_VIDEO" ] || { [ -n "$CAM_INIT" ] && [ -x "$CAM_INIT" ] && "$CAM_INIT" || true; }
  [ -e "$CAM_VIDEO" ] || { err "$CAM_VIDEO 不存在;先 csi-camera-init $CAM_ID 并重启使摄像头生效"; exit 1; }
  local yaml; yaml="$(build_yaml "$model")"
  export SOC=am62a TERM="${TERM:-xterm}"
  export GST_PLUGIN_PATH=/opt/ti/edgeai/gstreamer/plugins
  export LD_LIBRARY_PATH=/opt/ti/edgeai/lib:/opt/ti/edgeai/gstreamer/lib
  trap cleanup EXIT INT TERM
  echo "[csi-camera-demo] 摄像头=$CAM_ID  模型=$model"
  echo "[1/3] 清理残留 + 停 lightdm 让出显示 ..."; kill_app; systemctl stop lightdm 2>/dev/null || true; sleep 2
  echo "[2/3] warm-up (c7x reset + 预热一次, 首次 cold-start 不稳) ..."
  c7x_reset; timeout -s KILL 18 python3 "$APP" "$yaml" >/dev/null 2>&1 || true; kill_app; c7x_reset
  echo "[3/3] 运行 (画面在 HDMI 显示器, Ctrl+C 退出) ..."
  cd "$(dirname "$APP")"; python3 "$APP" "$yaml"
}

cmd_menu() {
  cmd_list || exit 1
  local sel; read -r -p $'\n输入编号运行 (回车取消): ' sel
  [ -n "$sel" ] || { echo "已取消"; exit 0; }
  cmd_run "$sel"
}

usage() { sed -n '2,18p' "$SELF" | sed 's/^# \{0,1\}//'; }

main() {
  local sub="${1:-}"
  case "$sub" in
    list)             cmd_list ;;
    run)              [ -n "${2:-}" ] || { err "用法: csi-camera-demo run <编号|名>"; exit 1; }; cmd_run "$2" ;;
    menu|"")          cmd_menu ;;
    -h|--help|help)   usage ;;
    *)                cmd_run "$sub" ;;   # 简写: csi-camera-demo <编号|名>
  esac
}
main "$@"
