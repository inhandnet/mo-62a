/*
 * Extend the primary memorycontroller node with Samsung 2GB compat config.
 * The driver reads ti,compat-mr5 / ti,compat-mr8 after the first DDR init
 * to detect the chip and, if matched, re-initializes with this config.
 *
 * MR5 = 0x01 : Samsung (JEDEC JEP106)
 * MR8 = 0x03 : 8Gb per die (LPDDR4 MR8[3:0] density encoding)
 */
&memorycontroller {
	ti,compat-mr5      = <0x01>;
	ti,compat-mr8      = <0x03>;
	ti,compat-freq1    = <DDRSS_SAMSUNG_PLL_FREQUENCY_1>;
	ti,compat-freq2    = <DDRSS_SAMSUNG_PLL_FREQUENCY_2>;
	ti,compat-fhs-cnt  = <DDRSS_SAMSUNG_PLL_FHS_CNT>;
	ti,compat-ddr-size = <0x80000000>;	/* 2GB */
	ti,compat-ctl-data = <
		DDRSS_SAMSUNG_CTL_0_DATA
		DDRSS_SAMSUNG_CTL_1_DATA
		DDRSS_SAMSUNG_CTL_2_DATA
		DDRSS_SAMSUNG_CTL_3_DATA
