# Mo 62A: 重新打开 CPU 动态调频（DVFS）
#
# ti_rt.config 的 "#Disable PM features" 段落把 CONFIG_CPU_FREQ 关掉了（RT 延迟考量）。
# 本片段在其之后应用以覆盖该项。DT 侧已就绪：cpu@0..3 均有 operating-points-v2
# 指向 a53_opp_table，且 k3-am62a7-mo-62a.dts 已补 1400MHz 档位。
# 本片 SoC efuse 速度等级为 U，7 档（200/400/600/800/1000/1250/1400 MHz）全部可用。
#
# 注意：DT 中 clock-latency-ns = 6ms，真正动态调频会显著增大 RT 抖动。
# 默认调速器仍为 performance（见 defconfig 的 CPU_FREQ_DEFAULT_GOV_PERFORMANCE），
# 即开机锁最高频、运行期不换频，对 RT 影响最小；需要真正 DVFS 时再在运行期切换
# 到 schedutil/ondemand。
#
# CPU_IDLE 保持关闭（属空闲状态管理，与调频无关，对 RT 影响更大）。
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_ARM_TI_CPUFREQ=y
CONFIG_CPU_FREQ_STAT=y

# 调速器：保留 performance 为默认，另备 schedutil（现代内核推荐）与 ondemand
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
