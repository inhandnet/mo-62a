#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
net — MO-62A 网络产测命令。

用法：
    net test eth [ping目标]    # 以太网(end0)：链路up + 千兆 + ping通 -> OK!/FAIL!
    net                        # 打印网络信息

判定顺序：① carrier 连接 ② 协商到 1000Mbps（千兆用满 4 对差分线，验 RJ45/变压器/PHY/线焊接）
         ③ ping 目标可达（默认=默认网关，可用参数指定）。三者全过 -> OK!，否则 -> FAIL!。

本命令只读 sysfs + ping，不改任何配置（零持久化）。
"""

import os
import subprocess
import sys

OK_MSG   = "OK!"
FAIL_MSG = "FAIL!"

GIGABIT = "1000"


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def _fail(reason=None):
    if reason:
        print("net: %s" % reason, file=sys.stderr)
    print(FAIL_MSG)
    sys.exit(1)


def _eth_iface():
    """优先 end0；否则第一个非无线的以太网口。"""
    if os.path.isdir("/sys/class/net/end0"):
        return "end0"
    try:
        names = sorted(os.listdir("/sys/class/net"))
    except OSError:
        return None
    for n in names:
        if n == "lo" or n.startswith(("wlan", "docker", "veth", "br-", "p2p", "dummy")):
            continue
        if _read("/sys/class/net/%s/type" % n) == "1" \
                and not os.path.isdir("/sys/class/net/%s/wireless" % n):
            return n
    return None


def _default_gw(iface):
    """默认路由网关 IP（优先本 iface 上的）。"""
    try:
        out = subprocess.run(["ip", "-4", "route", "show", "default"],
                             capture_output=True, text=True).stdout
    except Exception:
        return None
    gw_any = None
    for line in out.splitlines():
        p = line.split()
        if "via" in p:
            gw = p[p.index("via") + 1]
            if "dev" in p and p[p.index("dev") + 1] == iface:
                return gw
            gw_any = gw_any or gw
    return gw_any


def _ping(iface, target):
    r = subprocess.run(["ping", "-c", "2", "-W", "2", "-I", iface, target],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


def cmd_test_eth(args):
    iface = _eth_iface()
    if not iface:
        _fail("未找到以太网口")
    # ① 链路
    if _read("/sys/class/net/%s/carrier" % iface) != "1":
        _fail("%s 链路未连接（carrier != 1）" % iface)
    # ② 千兆
    speed = _read("/sys/class/net/%s/speed" % iface)
    if speed != GIGABIT:
        _fail("%s 非千兆（speed=%s Mbps）" % (iface, speed))
    # ③ ping
    target = args[0] if args else _default_gw(iface)
    if not target:
        _fail("无 ping 目标（无默认网关，可指定：net test eth <ip>）")
    if not _ping(iface, target):
        _fail("ping %s 不通" % target)
    print(OK_MSG)
    sys.exit(0)


def cmd_info():
    iface = _eth_iface()
    print("网络产测：")
    if iface:
        print("  以太网口 : %s  carrier=%s  speed=%s Mbps"
              % (iface, _read("/sys/class/net/%s/carrier" % iface),
                 _read("/sys/class/net/%s/speed" % iface)))
        print("  默认网关 : %s" % (_default_gw(iface) or "无"))
    else:
        print("  以太网口 : 未找到")
    print("用法：net test eth [ping目标]")


def main():
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "test" and argv[1] == "eth":
        cmd_test_eth(argv[2:])
    elif not argv:
        cmd_info()
    else:
        _fail("用法: net test eth [ping目标] | net")


if __name__ == "__main__":
    main()
