#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
audio — MO-62A 音频产测命令。

用法：
    audio test headphone          # 3.5mm 耳机口 TRRS 回环（播放1kHz+录音，FFT SNR）-> OK!/FAIL!
    audio test hdmi               # HDMI 音频：随机频率正弦 -> 读回 PC 测得频率比对 -> OK!/FAIL!
    audio test hdmi --selftest    # HDMI 自测：不依赖采集卡，自动回填生成频率
    audio                         # 打印音频信息（声卡/可测对象）

要求（headphone 测试）：
  * 3.5mm 口插 **TRRS 回环线**（HP L/R 各经 ~100Ω 接到 MIC/SLEEVE）；
  * 需 root。板载声卡 = card 0（AM62Ax-SKEVM）。

要求（hdmi 测试，Challenge 频率）：
  * HDMI 接口连接采集卡，采集卡 USB 接 PC（PC 打开采集卡=拉高 HPD，Mo62A 才输出）；
  * 本命令等 HDMI 连上后，在 HDMI 声卡(hw:1,0) 播放一个**随机频率**正弦，
    打印 "Tone Freq (Hz):" 等 PC 回填「测得频率」，按容差比对 -> OK!/FAIL!；
  * PC 侧经采集卡音频输入抓取 + FFT 测频（见 pc-tools 脚本），设备只生成+比对。

设计铁律（零持久化 + 强制还原）：
  headphone 用 `alsactl store/restore` 存/复原整卡 mixer；临时文件放 /dev/shm；
  无论成败/异常/中断都在 finally 还原 mixer / 杀残留 gst。
"""

import glob
import os
import secrets
import select
import signal
import subprocess
import sys
import time

CARD          = 0
DEVICE        = "hw:0,0"
RATE          = 48000
CHANNELS      = 2
TEST_FREQ     = 1000
PLAY_VOL      = 0.2
REC_SECONDS   = 1
SNR_THRESHOLD = 10.0

# HDMI 音频（Challenge 频率）
HDMI_DEVICE      = "hw:1,0"
HDMI_RATE        = 48000
HDMI_WAIT_S      = 30                     # 等待 PC 回填测得频率的超时(秒)
HDMI_CONN_WAIT   = 15                     # 等 HDMI sink 上线(PC 激活采集卡)
HDMI_STATUS_GLOB = "/sys/class/drm/card*-HDMI*/status"
HDMI_FREQS       = [500, 800, 1100, 1500, 2000, 2600, 3200]   # 随机挑战音调（间隔大，易测）
HDMI_TOL         = 60                     # 回填频率与生成频率的容差(Hz)

# 临时文件放 /dev/shm（Linux 恒为 tmpfs/内存），与镜像 /tmp 挂载方式无关，
# 保证测试临时数据绝不落 SD 文件系统。
STATE_BAK = "/dev/shm/mo_audio_state.bak"
REC_RAW   = "/dev/shm/mo_audio_loopback.raw"

OK_MSG   = "OK!"
FAIL_MSG = "FAIL!"
VERBOSE  = bool(os.environ.get("MO_FACTORY_VERBOSE"))

# 已验证的 WM8960/AM62Ax mixer 配置（顺序执行）：HP 输出 + Mic3R 采集路径。
MIXER = [
    ("PCM", "80"),
    ("HP", "on"),
    ("HP DAC", "70"),
    ("Left HP Mixer DACL1", "on"),
    ("Right HP Mixer DACR1", "on"),
    ("Left PGA Mixer Line1L", "off"),
    ("Left PGA Mixer Line1R", "off"),
    ("Left PGA Mixer Line2L", "off"),
    ("Left PGA Mixer Mic3L", "off"),
    ("Left PGA Mixer Mic3R", "on"),
    ("Right PGA Mixer Line1L", "off"),
    ("Right PGA Mixer Line1R", "off"),
    ("Right PGA Mixer Line2R", "off"),
    ("Right PGA Mixer Mic3L", "off"),
    ("Right PGA Mixer Mic3R", "on"),
    ("PGA", "40,40,on"),
]


def _sh(*args, **kw):
    return subprocess.run(list(args), stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, **kw)


def _fail(reason=None):
    if reason:
        print("audio: %s" % reason, file=sys.stderr)
    print(FAIL_MSG)
    sys.exit(1)


def _require_root():
    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        _fail("需要 root（sudo）")


def _amixer_set(name, val):
    _sh("amixer", "-c", str(CARD), "sset", name, val)


def _calc_snr(left):
    """左声道 int16 numpy 数组 -> 1kHz 相对邻近噪声的 SNR(dB)。"""
    import numpy as np
    data = left.astype(np.float32)
    n = min(len(data), RATE)
    fft = np.abs(np.fft.rfft(data[:n]))
    freqs = np.fft.rfftfreq(n, 1.0 / RATE)
    i1k = int(TEST_FREQ * n / RATE)
    sig = fft[i1k]
    mask = ((freqs >= 200) & (freqs < 900)) | ((freqs > 1100) & (freqs <= 3000))
    noise = float(np.max(fft[mask])) if mask.any() else 1.0
    return float(20.0 * np.log10(sig / (noise + 1e-10)))


def _cleanup(state_saved):
    _sh("pkill", "-f", "gst-launch")
    if state_saved:
        _sh("alsactl", "--file", STATE_BAK, "restore", str(CARD))
    for f in (STATE_BAK, REC_RAW):
        try:
            os.remove(f)
        except OSError:
            pass


def test_headphone():
    _require_root()

    def _raise(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, _raise)
    signal.signal(signal.SIGHUP, _raise)

    # 声卡在否
    try:
        with open("/proc/asound/cards") as f:
            cards = f.read()
    except OSError:
        cards = ""
    if "AM62Ax" not in cards and "am62ax" not in cards.lower():
        _fail("未找到板载声卡 AM62Ax（card %d）" % CARD)

    state_saved = False
    ok = False
    detail = ""
    try:
        # 存整卡 mixer（运行时，临时文件在 /dev/shm）
        if _sh("alsactl", "--file", STATE_BAK, "store", str(CARD)).returncode == 0:
            state_saved = True

        # 配置 mixer
        for name, val in MIXER:
            _amixer_set(name, val)

        # 同步播放 1kHz + 录音
        play_bufs = int(RATE * (REC_SECONDS + 1) / 800)
        rec_bufs = int(RATE * REC_SECONDS / 480)
        _sh("pkill", "-f", "gst-launch")
        time.sleep(0.2)
        try:
            os.remove(REC_RAW)
        except OSError:
            pass

        play = subprocess.Popen(
            ["gst-launch-1.0", "audiotestsrc", "wave=sine",
             "freq=%d" % TEST_FREQ, "volume=%s" % PLAY_VOL,
             "num-buffers=%d" % play_bufs, "!",
             "audio/x-raw,rate=%d,channels=%d" % (RATE, CHANNELS), "!",
             "alsasink", "device=%s" % DEVICE],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.3)

        rec = subprocess.run(
            ["gst-launch-1.0", "alsasrc", "device=%s" % DEVICE,
             "num-buffers=%d" % rec_bufs, "!",
             "audio/x-raw,rate=%d,format=S16LE,channels=%d" % (RATE, CHANNELS), "!",
             "filesink", "location=%s" % REC_RAW],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=REC_SECONDS + 10)
        try:
            play.terminate()
        except Exception:
            pass
        _sh("pkill", "-f", "gst-launch")

        if rec.returncode != 0:
            _cleanup(state_saved)
            _fail("录音失败（gst rc=%d）" % rec.returncode)

        with open(REC_RAW, "rb") as f:
            raw = f.read()
        if len(raw) < RATE * 2:          # < 0.5s 立体声数据
            _cleanup(state_saved)
            _fail("录音数据过短（%d 字节）" % len(raw))

        import numpy as np
        alls = np.frombuffer(raw, dtype=np.int16)
        left = alls[::2]                 # 偶数索引 = 左声道
        snr = _calc_snr(left)
        detail = "SNR=%.1f dB (阈值 %.0f)" % (snr, SNR_THRESHOLD)
        ok = snr >= SNR_THRESHOLD

    except KeyboardInterrupt:
        ok = False
        detail = "中断"
    except Exception as e:
        _cleanup(state_saved)
        _fail(str(e))
    finally:
        _cleanup(state_saved)

    if not ok and detail:                # 仅失败时把 SNR 打到 stderr 便于排查
        if VERBOSE:
            print("audio: %s" % detail, file=sys.stderr)
    print(OK_MSG if ok else FAIL_MSG)
    sys.exit(0 if ok else 1)


def _read_line(timeout):
    """从 stdin 读一行（去尾部 CR/LF）；超时或 EOF 返回 None。"""
    try:
        r, _, _ = select.select([sys.stdin], [], [], timeout)
    except Exception:
        return None
    if not r:
        return None
    line = sys.stdin.readline()
    if line == "":
        return None
    return line.rstrip("\r\n")


def _wait_hdmi_connected(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for p in glob.glob(HDMI_STATUS_GLOB):
            try:
                with open(p) as f:
                    if f.read().strip() == "connected":
                        return True
            except OSError:
                pass
        time.sleep(0.3)
    return False


def _wake_display():
    """唤醒显示：重启 lightdm 拉起新会话（息屏时 HDMI 无输出、音频也不出）。"""
    _sh("systemctl", "restart", "lightdm")
    time.sleep(8)                      # 等 Xorg/HDMI 重新起来


def test_hdmi(selftest=False, wait_s=HDMI_WAIT_S):
    _require_root()

    def _raise(signum, frame):
        raise KeyboardInterrupt
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, _raise)

    # 确认 HDMI 声卡存在
    try:
        with open("/proc/asound/cards") as f:
            cards = f.read()
    except OSError:
        cards = ""
    if "HDMI" not in cards:
        _fail("未找到 HDMI 声卡")

    freq = secrets.choice(HDMI_FREQS)     # 随机挑战音调
    ok = False
    detail = ""
    play = None
    try:
        _sh("pkill", "-f", "gst-launch")
        time.sleep(0.2)
        if not selftest:
            _wake_display()          # 息屏时 HDMI 无输出 -> 先唤醒显示

        if not selftest and not _wait_hdmi_connected(HDMI_CONN_WAIT):
            detail = "HDMI 未连接（%ds 内 sink 未上线；PC 是否已激活采集卡？）" % HDMI_CONN_WAIT
        else:
            # 循环播放随机频率正弦到 HDMI（覆盖整个等待窗口，直到被 terminate）
            play = subprocess.Popen(
                ["gst-launch-1.0", "audiotestsrc", "wave=sine", "is-live=true",
                 "freq=%d" % freq, "volume=0.8", "!",
                 "audioconvert", "!", "audioresample", "!",
                 "audio/x-raw,rate=%d,channels=2" % HDMI_RATE, "!",
                 "alsasink", "device=%s" % HDMI_DEVICE],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        if not detail:
            if VERBOSE:
                print("HDMI 已输出正弦，Tone Freq(明文,仅调试)=%d Hz" % freq, file=sys.stderr)

            if selftest:
                print("[selftest] 自动回填生成频率 %d Hz" % freq, file=sys.stderr)
                got = str(freq)
            else:
                sys.stderr.write("Tone Freq (Hz):\n")
                sys.stderr.flush()
                got = _read_line(wait_s)

            if got is None:
                detail = "超时/EOF 未收到频率（%ds）" % wait_s
            else:
                try:
                    measured = float(got.strip())
                except ValueError:
                    measured = None
                if measured is None:
                    detail = "回填非数值: %r" % got
                elif abs(measured - freq) <= HDMI_TOL:
                    ok = True
                    detail = "匹配（生成 %d, 回填 %.1f）" % (freq, measured)
                else:
                    detail = "不匹配（生成 %d, 回填 %.1f, 容差 %d）" % (freq, measured, HDMI_TOL)
    except KeyboardInterrupt:
        detail = "中断"
    except Exception as e:
        _sh("pkill", "-f", "gst-launch")
        detail = str(e)
    finally:
        try:
            for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                signal.signal(s, signal.SIG_DFL)
            if play is not None:
                try:
                    play.terminate()
                    play.wait(timeout=2)
                except Exception:
                    pass
            _sh("pkill", "-f", "gst-launch")
        except KeyboardInterrupt:
            pass

    if detail and not ok and VERBOSE:
        print("audio: %s" % detail, file=sys.stderr)
    print(OK_MSG if ok else FAIL_MSG)
    sys.exit(0 if ok else 1)


def cmd_info():
    print("音频产测：")
    try:
        with open("/proc/asound/cards") as f:
            sys.stdout.write(f.read())
    except OSError:
        pass
    print("可测对象： headphone（3.5mm 回环，需 TRRS 回环线）")
    print("           hdmi（HDMI 音频，随机频率 Challenge，需 PC 采集卡测频回填）")
    print("用法：     audio test headphone | audio test hdmi [--selftest] [--timeout N]")


def main():
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "test" and argv[1] == "headphone":
        test_headphone()
    elif len(argv) >= 2 and argv[0] == "test" and argv[1] == "hdmi":
        selftest = False
        wait_s = HDMI_WAIT_S
        rest = argv[2:]
        i = 0
        while i < len(rest):
            if rest[i] == "--selftest":
                selftest = True
            elif rest[i] == "--timeout" and i + 1 < len(rest):
                try:
                    wait_s = int(rest[i + 1])
                except ValueError:
                    _fail("--timeout 需要整数秒")
                i += 1
            i += 1
        test_hdmi(selftest=selftest, wait_s=wait_s)
    elif not argv:
        cmd_info()
    else:
        _fail("用法: audio test headphone | audio test hdmi [--selftest] [--timeout N] | audio")


if __name__ == "__main__":
    main()
