#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
display — MO-62A 显示产测命令。

用法：
    display hdmi detect [expected_qr]     # HDMI 输出二维码，等 PC 回传采集图，解码比对
    display                               # 打印显示信息

HDMI 画面回环流程：
  1. Mo62A 停 lightdm，在 HDMI(fb0) 上全屏显示一个二维码
  2. 等待 PC 通过 scp 把采集到的 HDMI 图像发到 /tmp/mo_hdmi_cap.jpg
  3. 解码二维码，与 expected_qr（或生成值）比对 -> OK!/FAIL!
  4. 无论成败，恢复 lightdm

PC 端只做采集+scp，不做判断。
"""

import glob
import os
import signal
import subprocess
import sys
import time

os.environ.setdefault("OPENCV_LOG_LEVEL", "SILENT")

FB_PATH       = "/dev/fb0"
FB_SIZE_PATH  = "/sys/class/graphics/fb0/virtual_size"
FB_BPP_PATH   = "/sys/class/graphics/fb0/bits_per_pixel"
FB_STRIDE_PATH= "/sys/class/graphics/fb0/stride"
CAP_PATH      = "/tmp/mo_hdmi_cap.png"
REF_PATH      = "/tmp/mo_hdmi_test.png"
DM_SVC        = "lightdm"
WAIT_S        = 60
QR_SIZE       = 800                    # 二维码像素尺寸（cv2 解码需要足够大）
VERBOSE       = bool(os.environ.get("MO_FACTORY_VERBOSE"))

OK_MSG   = "OK!"
FAIL_MSG = "FAIL!"


def _sh(*args, **kw):
    return subprocess.run(list(args), stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, **kw)


def _fail(reason=None):
    if reason:
        print("display: %s" % reason, file=sys.stderr)
    print(FAIL_MSG)
    sys.exit(1)


def _require_root():
    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        _fail("需要 root（sudo）")


def _fb_info():
    try:
        with open(FB_SIZE_PATH) as f:
            w, h = map(int, f.read().strip().split(","))
    except Exception:
        return None
    try:
        with open(FB_BPP_PATH) as f:
            bpp = int(f.read().strip())
    except Exception:
        bpp = 32
    try:
        with open(FB_STRIDE_PATH) as f:
            stride = int(f.read().strip())
    except Exception:
        stride = w * bpp // 8
    return w, h, bpp, stride


def _generate_qr(content):
    """生成二维码 RGBA 图像(PIL Image)。"""
    import qrcode
    from PIL import Image
    qr = qrcode.QRCode(version=None, box_size=10, border=4,
                       error_correction=qrcode.constants.ERROR_CORRECT_M)
    qr.add_data(content)
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white").convert("RGBA")
    # 最近邻放大，保持模块边缘锐利，便于 cv2 解码
    img = img.resize((QR_SIZE, QR_SIZE), Image.NEAREST)
    return img


def _clear_fb(fb, w, h, bpp, stride, color_bytes):
    row = color_bytes * w + b"\x00" * (stride - w * (bpp // 8))
    for _ in range(h):
        fb.write(row)


def _show_qr(content):
    w, h, bpp, stride = _fb_info()
    if bpp not in (16, 24, 32):
        raise RuntimeError("不支持的 fb bpp=%d" % bpp)

    qr = _generate_qr(content)
    # 居中
    off_x = (w - QR_SIZE) // 2
    off_y = (h - QR_SIZE) // 2

    # 同时保存一份参考图到 /tmp（PNG 无损，避免 cv2 解码失败）
    try:
        qr.convert("RGB").save(REF_PATH)
    except Exception:
        if VERBOSE:
            import traceback
            traceback.print_exc()

    with open(FB_PATH, "r+b") as fb:
        # 白底
        _clear_fb(fb, w, h, bpp, stride, b"\xff\xff\xff\xff"[:bpp//8])
        # 把二维码贴到中央
        px = list(qr.getdata())  # [(R,G,B,A), ...]
        for y in range(QR_SIZE):
            row_bytes = b""
            for x in range(QR_SIZE):
                r, g, b, a = px[y * QR_SIZE + x]
                if bpp == 32:
                    row_bytes += bytes([b, g, r, a])
                elif bpp == 24:
                    row_bytes += bytes([b, g, r])
                elif bpp == 16:
                    # RGB565
                    row_bytes += bytes([((g & 0x1c) << 3) | (b >> 3),
                                        (r & 0xf8) | (g >> 5)])
            fb.seek((off_y + y) * stride + off_x * (bpp // 8))
            fb.write(row_bytes)
        fb.flush()
        os.fsync(fb.fileno())


def _decode_qr(path):
    import cv2
    img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)
    if img is None:
        return None
    data, _, _ = cv2.QRCodeDetector().detectAndDecode(img)
    return data


def _wait_capture(deadline):
    while time.monotonic() < deadline:
        if os.path.exists(CAP_PATH) and os.path.getsize(CAP_PATH) > 100:
            return True
        time.sleep(0.2)
    return False


def cmd_hdmi_detect(expected=None, loopback=False, wait_s=WAIT_S):
    _require_root()

    def _raise(signum, frame):
        raise KeyboardInterrupt
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, _raise)

    # 生成或复用期望内容
    if expected is None:
        import secrets
        expected = "MO62A-HDMI-" + secrets.token_hex(8)
    else:
        expected = str(expected)

    dm_active = (subprocess.run(["systemctl", "is-active", DM_SVC],
                                capture_output=True, text=True).stdout.strip() == "active")

    ok = False
    detail = ""
    try:
        if dm_active:
            _sh("systemctl", "stop", DM_SVC)
            time.sleep(1)

        _show_qr(expected)

        if loopback:
            # 自测模式：直接复制参考图为回传图
            import shutil
            shutil.copy(REF_PATH, CAP_PATH)

        if VERBOSE:
            if loopback:
                print("自测模式：已复制 %s -> %s" % (REF_PATH, CAP_PATH), file=sys.stderr)
            else:
                print("HDMI 已输出二维码，内容: %s" % expected, file=sys.stderr)
                print("参考图已保存: %s (复制为 %s 即模拟 PC 回传)" % (REF_PATH, CAP_PATH), file=sys.stderr)
                print("等待 PC 回传采集图: %s (超时 %ds)" % (CAP_PATH, wait_s), file=sys.stderr)

        if _wait_capture(time.monotonic() + wait_s):
            data = _decode_qr(CAP_PATH)
            if data == expected:
                detail = "解码匹配: %s" % data
                ok = True
            else:
                detail = "二维码不匹配（期望 %r，解得 %r）" % (expected, data)
        else:
            detail = "超时未收到 %s" % CAP_PATH
    except KeyboardInterrupt:
        detail = "中断"
    except Exception as e:
        detail = str(e)
    finally:
        try:
            os.remove(CAP_PATH)
        except OSError:
            pass
        if dm_active:
            _sh("systemctl", "start", DM_SVC)

    if detail and not ok and VERBOSE:
        print("display: %s" % detail, file=sys.stderr)
    print(OK_MSG if ok else FAIL_MSG)
    sys.exit(0 if ok else 1)


def cmd_info():
    print("显示产测：")
    st = "unknown"
    try:
        for p in glob.glob("/sys/class/drm/card*-HDMI*/status"):
            with open(p) as f:
                st = f.read().strip()
            print("  HDMI %s: %s" % (p, st))
    except OSError:
        pass
    info = _fb_info()
    if info:
        print("  fb0: %dx%d bpp=%d stride=%d" % info)
    else:
        print("  fb0: 读取失败")
    print("用法：display hdmi detect [expected_qr]")


def main():
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "hdmi" and argv[1] == "detect":
        rest = argv[2:]
        loopback = False
        wait_s = WAIT_S
        skip_next = False
        filtered = []
        for i, tok in enumerate(rest):
            if skip_next:
                skip_next = False
                continue
            if tok in ("--loopback", "-l"):
                loopback = True
            elif tok == "--timeout" and i + 1 < len(rest):
                try:
                    wait_s = int(rest[i + 1])
                except ValueError:
                    _fail("--timeout 需要整数秒")
                skip_next = True
            else:
                filtered.append(tok)
        cmd_hdmi_detect(filtered[0] if filtered else None, loopback=loopback, wait_s=wait_s)
    elif not argv:
        cmd_info()
    else:
        _fail("用法: display hdmi detect [--loopback] [--timeout N] [expected_qr] | display")


if __name__ == "__main__":
    main()
