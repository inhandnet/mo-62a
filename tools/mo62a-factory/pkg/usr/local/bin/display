#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
display — MO-62A 显示产测命令（Challenge Code 方案）。

用法：
    display hdmi detect [--timeout N]     # HDMI 输出随机 Challenge Code 二维码，
                                          # 读回对端解码结果并比对 -> OK!/FAIL!
    display hdmi detect --selftest        # 自测：显示后自行回填比对（不读 stdin）
    display                               # 打印显示信息

Challenge Code 回环流程：
  1. Mo62A 随机生成一串 16~32 字符（大小写+数字+符号，无空格/回车）作为 Challenge Code
  2. 停 lightdm，在 HDMI(fb0) 上全屏显示该串的二维码
  3. 打印 "Challenge Code:" 提示，等待对端从 stdin 输入
  4. 对端（PC 采集卡抓帧 + 解码二维码）把解得的字符串输入回来
  5. 与生成值精确比对 -> OK!/FAIL!；无论成败恢复 lightdm

设备端只做「生成 + 显示 + 比对」；二维码解码在 PC 端完成，设备不依赖 zbar/cv2。
判定结果只走 stdout（OK!/FAIL!），提示与诊断走 stderr。
"""

import glob
import os
import secrets
import select
import signal
import subprocess
import sys
import time

FB_PATH        = "/dev/fb0"
FB_SIZE_PATH   = "/sys/class/graphics/fb0/virtual_size"
FB_BPP_PATH    = "/sys/class/graphics/fb0/bits_per_pixel"
FB_STRIDE_PATH = "/sys/class/graphics/fb0/stride"
DM_SVC         = "lightdm"
HDMI_STATUS_GLOB = "/sys/class/drm/card*-HDMI*/status"
HDMI_WAIT_S    = 15                     # 等 HDMI sink 上线(PC 激活采集卡)的超时(秒)
WAIT_S         = 30                     # 等待对端输入的默认超时(秒)，--timeout 可覆盖
QR_SIZE        = 800                    # 二维码像素尺寸（够大，PC 端易解）
# Challenge Code 字符集：可打印 ASCII 0x21-0x7E（大小写+数字+符号），排除空格与 CR/LF
CHALLENGE_CHARS = "".join(chr(c) for c in range(0x21, 0x7F))
CHALLENGE_MIN  = 16
CHALLENGE_MAX  = 32
PROMPT         = "Challenge Code:"      # 提示单独一行，输入落到下一行行首
VERBOSE        = bool(os.environ.get("MO_FACTORY_VERBOSE"))

OK_MSG   = "OK!"
FAIL_MSG = "FAIL!"


def _sh(*args, **kw):
    return subprocess.run(list(args), stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, **kw)


def _fail(reason=None):
    if reason:
        print("display: %s" % reason, file=sys.stderr)
    print(FAIL_MSG)
    sys.exit(1)


def _require_root():
    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        _fail("需要 root（sudo）")


def _gen_challenge():
    """随机 16~32 字符 Challenge Code（大小写+数字+符号，无空格/CR/LF）。"""
    n = CHALLENGE_MIN + secrets.randbelow(CHALLENGE_MAX - CHALLENGE_MIN + 1)
    return "".join(secrets.choice(CHALLENGE_CHARS) for _ in range(n))


def _fb_info():
    try:
        with open(FB_SIZE_PATH) as f:
            w, h = map(int, f.read().strip().split(","))
    except Exception:
        return None
    try:
        with open(FB_BPP_PATH) as f:
            bpp = int(f.read().strip())
    except Exception:
        bpp = 32
    try:
        with open(FB_STRIDE_PATH) as f:
            stride = int(f.read().strip())
    except Exception:
        stride = w * bpp // 8
    return w, h, bpp, stride


def _generate_qr(content):
    """生成二维码 RGBA 图像(PIL Image)。"""
    import qrcode
    from PIL import Image
    qr = qrcode.QRCode(version=None, box_size=10, border=4,
                       error_correction=qrcode.constants.ERROR_CORRECT_M)
    qr.add_data(content)
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white").convert("RGBA")
    # 最近邻放大，保持模块边缘锐利，便于 PC 端解码
    img = img.resize((QR_SIZE, QR_SIZE), Image.NEAREST)
    return img


def _clear_fb(fb, w, h, bpp, stride, color_bytes):
    row = color_bytes * w + b"\x00" * (stride - w * (bpp // 8))
    for _ in range(h):
        fb.write(row)


def _show_qr(content):
    w, h, bpp, stride = _fb_info()
    if bpp not in (16, 24, 32):
        raise RuntimeError("不支持的 fb bpp=%d" % bpp)

    qr = _generate_qr(content)
    # 居中
    off_x = (w - QR_SIZE) // 2
    off_y = (h - QR_SIZE) // 2

    with open(FB_PATH, "r+b") as fb:
        # 白底
        _clear_fb(fb, w, h, bpp, stride, b"\xff\xff\xff\xff"[:bpp // 8])
        # 把二维码贴到中央
        px = list(qr.getdata())  # [(R,G,B,A), ...]
        for y in range(QR_SIZE):
            row_bytes = b""
            for x in range(QR_SIZE):
                r, g, b, a = px[y * QR_SIZE + x]
                if bpp == 32:
                    row_bytes += bytes([b, g, r, a])
                elif bpp == 24:
                    row_bytes += bytes([b, g, r])
                elif bpp == 16:
                    # RGB565
                    row_bytes += bytes([((g & 0x1c) << 3) | (b >> 3),
                                        (r & 0xf8) | (g >> 5)])
            fb.seek((off_y + y) * stride + off_x * (bpp // 8))
            fb.write(row_bytes)
        fb.flush()
        os.fsync(fb.fileno())


def _hdmi_connected():
    for p in glob.glob(HDMI_STATUS_GLOB):
        try:
            with open(p) as f:
                if f.read().strip() == "connected":
                    return True
        except OSError:
            pass
    return False


def _wait_hdmi_connected(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if _hdmi_connected():
            return True
        time.sleep(0.3)
    return False


def _read_line(timeout):
    """从 stdin 读一行（去尾部 CR/LF）；超时或 EOF 返回 None。"""
    try:
        r, _, _ = select.select([sys.stdin], [], [], timeout)
    except Exception:
        return None
    if not r:
        return None
    line = sys.stdin.readline()
    if line == "":
        return None          # EOF
    return line.rstrip("\r\n")


def cmd_hdmi_detect(wait_s=WAIT_S, selftest=False):
    _require_root()

    def _raise(signum, frame):
        raise KeyboardInterrupt
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, _raise)

    challenge = _gen_challenge()
    dm_active = (subprocess.run(["systemctl", "is-active", DM_SVC],
                                capture_output=True, text=True).stdout.strip() == "active")
    ok = False
    detail = ""
    try:
        if dm_active:
            _sh("systemctl", "stop", DM_SVC)
            time.sleep(1)

        if not selftest and not _wait_hdmi_connected(HDMI_WAIT_S):
            detail = "HDMI 未连接（%ds 内 sink 未上线；PC 是否已激活采集卡？）" % HDMI_WAIT_S
        else:
            _show_qr(challenge)

            if VERBOSE:
                print("Challenge Code(明文,仅调试): %s" % challenge, file=sys.stderr)

            if selftest:
                print("[selftest] 显示后自动回填 Challenge Code", file=sys.stderr)
                got = challenge
            else:
                sys.stderr.write(PROMPT + "\n")
                sys.stderr.flush()
                got = _read_line(wait_s)

            if got is None:
                detail = "超时/EOF 未收到输入（%ds）" % wait_s
            elif got == challenge:
                ok = True
                detail = "匹配"
            else:
                detail = "不匹配（期望 %d 字节，收到 %d 字节）" % (len(challenge), len(got))
                if VERBOSE:
                    detail += "；收到=%r" % got
    except KeyboardInterrupt:
        detail = "中断"
    except Exception as e:
        detail = str(e)
    finally:
        if dm_active:
            _sh("systemctl", "start", DM_SVC)

    if detail and not ok and VERBOSE:
        print("display: %s" % detail, file=sys.stderr)
    print(OK_MSG if ok else FAIL_MSG)
    sys.exit(0 if ok else 1)


def cmd_info():
    print("显示产测：")
    st = "unknown"
    try:
        for p in glob.glob("/sys/class/drm/card*-HDMI*/status"):
            with open(p) as f:
                st = f.read().strip()
            print("  HDMI %s: %s" % (p, st))
    except OSError:
        pass
    info = _fb_info()
    if info:
        print("  fb0: %dx%d bpp=%d stride=%d" % info)
    else:
        print("  fb0: 读取失败")
    print("用法：display hdmi detect [--timeout N] | display hdmi detect --selftest")


def main():
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "hdmi" and argv[1] == "detect":
        rest = argv[2:]
        selftest = False
        wait_s = WAIT_S
        i = 0
        while i < len(rest):
            tok = rest[i]
            if tok == "--selftest":
                selftest = True
            elif tok == "--timeout" and i + 1 < len(rest):
                try:
                    wait_s = int(rest[i + 1])
                except ValueError:
                    _fail("--timeout 需要整数秒")
                i += 1
            else:
                _fail("未知参数: %s" % tok)
            i += 1
        cmd_hdmi_detect(wait_s=wait_s, selftest=selftest)
    elif not argv:
        cmd_info()
    else:
        _fail("用法: display hdmi detect [--timeout N] [--selftest] | display")


if __name__ == "__main__":
    main()
